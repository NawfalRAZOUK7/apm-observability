# =========================
# APM Observability - DOCKER ENV
# =========================

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-please
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0,host.docker.internal,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,https://localhost:18443,https://127.0.0.1:18443,https://localhost:443,https://127.0.0.1:443,https://host.docker.internal:8443,https://host.docker.internal:18443
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_TIME_ZONE=UTC
DRF_PAGE_SIZE=50

WEB_PORT=8000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=apm
POSTGRES_USER=apm
POSTGRES_PASSWORD=apm

POSTGRES_APP_USER=apm_writer
POSTGRES_APP_PASSWORD=apm_writer_pass
POSTGRES_READONLY_USER=apm_reader
POSTGRES_READONLY_PASSWORD=apm_reader_pass

DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
READ_AFTER_WRITE_TTL=2

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_BIND=0.0.0.0:8000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Tracing (OpenTelemetry -> Collector -> Tempo) ----
OTEL_ENABLED=1
OTEL_SERVICE_NAME=apm-observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
DJANGO_LOG_LEVEL=INFO

# ---- Embeddings provider (Phase 8) ----
# Default is free/offline (local Ollama nomic-embed-text, 768-dim = drop-in for
# the existing VectorField). Set EMBED_PROVIDER=gemini for hosted quality.
EMBED_PROVIDER=local
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT=30

# ---- Gemini Embeddings (used when EMBED_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_TIMEOUT=10
GEMINI_EMBED_MAX_CHARS=8000
GEMINI_EMBED_MIN_DELAY_S=0

# ---- Alert delivery providers (Phase 4) ----
# Defaults are free/local (console log). Flip to a real channel by changing the
# provider and setting the matching webhook URL. Secrets stay here, never in
# alertmanager.yml.
#   CHAT_PROVIDER:  console | slack | discord | none
#   PAGER_PROVIDER: console | ntfy  | none
CHAT_PROVIDER=console
PAGER_PROVIDER=console
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NTFY_URL=
NTFY_TOPIC=apm-alerts
