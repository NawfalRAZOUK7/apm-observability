{
  "annotations": { "list": [ { "builtIn": 1, "datasource": "-- Grafana --", "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "title": "APM — DORA delivery metrics",
  "uid": "apm-dora",
  "tags": ["apm", "dora", "delivery"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "type": "stat",
      "title": "Deployments (window)",
      "targets": [ { "datasource": { "type": "postgres", "uid": "timescaledb" }, "rawSql": "SELECT count(*) AS value FROM dora_deployment WHERE deployed_at BETWEEN $__timeFrom() AND $__timeTo() AND status = 'success'", "format": "table", "refId": "A" } ]
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "type": "stat",
      "title": "Change failure rate",
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.15 }, { "color": "red", "value": 0.30 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "postgres", "uid": "timescaledb" }, "rawSql": "SELECT (count(*) FILTER (WHERE status <> 'success' OR caused_incident))::float / NULLIF(count(*),0) AS value FROM dora_deployment WHERE deployed_at BETWEEN $__timeFrom() AND $__timeTo()", "format": "table", "refId": "A" } ]
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "type": "stat",
      "title": "Median lead time (hours)",
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] },
      "targets": [ { "datasource": { "type": "postgres", "uid": "timescaledb" }, "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (deployed_at - committed_at))/3600.0) AS value FROM dora_deployment WHERE status='success' AND committed_at IS NOT NULL AND deployed_at BETWEEN $__timeFrom() AND $__timeTo()", "format": "table", "refId": "A" } ]
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "type": "timeseries",
      "title": "Deployment frequency (per day)",
      "targets": [ { "datasource": { "type": "postgres", "uid": "timescaledb" }, "rawSql": "SELECT time_bucket('1 day', deployed_at) AS time, environment AS metric, count(*) AS deployments FROM dora_deployment WHERE deployed_at BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1, 2 ORDER BY 1", "format": "time_series", "refId": "A" } ]
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "id": 5,
      "type": "table",
      "title": "Recent deployments",
      "targets": [ { "datasource": { "type": "postgres", "uid": "timescaledb" }, "rawSql": "SELECT deployed_at, environment, version, status, caused_incident FROM dora_deployment ORDER BY deployed_at DESC LIMIT 50", "format": "table", "refId": "A" } ]
    }
  ]
}
