# =========================
# APM Observability - ENV
# Copy to .env and edit
# =========================

# ---- Django ----
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-please
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0

# Optional
DJANGO_TIME_ZONE=UTC
DRF_PAGE_SIZE=50

# ---- Web container port (docker-compose) ----
WEB_PORT=8000

# ---- Postgres / TimescaleDB ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=apm
POSTGRES_USER=apm
POSTGRES_PASSWORD=apm
# Dedicated writer user (preferred)
POSTGRES_APP_USER=apm_writer
POSTGRES_APP_PASSWORD=apm_writer_pass
# Read-only user (analytics/Grafana)
POSTGRES_READONLY_USER=apm_reader
POSTGRES_READONLY_PASSWORD=apm_reader_pass

# Optional (for hosted Postgres)
# Examples: disable, require, verify-ca, verify-full
DB_SSLMODE=disable


# Optional: DB connection reuse (seconds)
DB_CONN_MAX_AGE=60

# Optional: keep reads on primary for N seconds after a write (replication lag)
READ_AFTER_WRITE_TTL=2

# Optional: test DB name override
# POSTGRES_TEST_DB=apm_test

# ---- SSL Configuration ----
# For development: set to false to skip SSL certificate verification
# For production: set to true or leave unset for proper certificate validation
SSL_VERIFY=false

# ---- Gunicorn (used by docker/entrypoint.sh) ----
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_BIND=0.0.0.0:8000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Tracing (OpenTelemetry) ----
# Off by default; the docker/demo stack turns it on and points at the collector.
OTEL_ENABLED=0
OTEL_SERVICE_NAME=apm-observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Structured JSON logs level
DJANGO_LOG_LEVEL=INFO

# ---- Embeddings provider (Phase 8) ----
# local  = Ollama nomic-embed-text (768-dim, free/offline; default)
# gemini = Gemini text-embedding-004 (hosted; needs GEMINI_API_KEY)
EMBED_PROVIDER=local
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT=30

# ---- OTLP ingestion controls (Phase 11) ----
# Tail sampling: keep all interesting traces (errors/slow), sample the rest.
OTLP_TAIL_SAMPLE_RATE=1.0     # fraction of non-interesting traces to keep (1.0 = all)
OTLP_SLOW_MS=500             # span duration considered "slow" (always kept)
# Per-project ingest rate limit (0 = unlimited). Backed by an in-process bucket;
# use Redis for cluster-wide limits in production.
OTLP_RATE_LIMIT_PER_SEC=0
OTLP_RATE_LIMIT_BURST=0

# ---- LLM intelligence (Phase 13) ----
# Text generation for AI postmortems + NL queries. Default 'none' => features
# fall back to deterministic templates/heuristics at $0 (no model needed).
#   LLM_PROVIDER: none | gemini | ollama
LLM_PROVIDER=none
GEMINI_TEXT_MODEL=gemini-1.5-flash
OLLAMA_TEXT_MODEL=llama3.2

# ---- Gemini Embeddings (used when EMBED_PROVIDER=gemini) ----
# Never commit real keys. Use local .env or secret manager.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_TIMEOUT=10
GEMINI_EMBED_MAX_CHARS=8000
GEMINI_EMBED_MIN_DELAY_S=0

# ---- Alert delivery providers (Phase 4) ----
# Defaults are free/local (console). Alertmanager posts to the Django sink
# (/sink/notify); the sink fans out to these channels based on severity.
# Secrets live here, never in alertmanager.yml.
#   CHAT_PROVIDER:  console | slack | discord | none
#   PAGER_PROVIDER: console | ntfy  | none
CHAT_PROVIDER=console
PAGER_PROVIDER=console
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NTFY_URL=
NTFY_TOPIC=apm-alerts
