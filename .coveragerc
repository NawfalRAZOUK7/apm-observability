# Coverage config for the Django test suite. The fail_under threshold below is
# the enforced floor — raise it as coverage improves (ratchet, never lower to
# pass). Measured on the app packages only; infra/generated code is excluded.
[run]
source =
    apm_platform
    observability
    tenancy
    notifications
    alerting
    dora
branch = True
omit =
    */migrations/*
    */tests/*
    */tests.py
    */__pycache__/*
    manage.py
    */wsgi.py
    */asgi.py
    */settings*.py
    */ci_settings.py
    .venv/*

[report]
show_missing = True
skip_covered = False
# Floor set just under the current measured coverage (~56%) so the gate passes
# today and can only move up. Ratchet this toward 70+ as tests are added; never
# lower it to make a red build pass.
fail_under = 55
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    def __repr__
