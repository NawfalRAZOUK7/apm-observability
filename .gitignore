# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3

# Virtualenv
.venv/
.ruff_cache/

# Env files
.env
.env.*
!.env.example
!.env.docker

# Local cluster config (generated)
configs/cluster/cluster.yml

# Django
staticfiles/
media/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Generated project outputs
reports/
archive/legacy/

# Generated local TLS / SSH material
docker/certs/private.key
docker/certs/pgbackrest/*.key
docker/certs/pgbackrest/*.csr
docker/certs/pgbackrest/*.srl
docker/backup/pgpass
archive/configs/**/id_rsa
archive/configs/**/id_rsa.pub
archive/configs/**/known_hosts
archive/configs/**/pgpass

# Terraform / OpenTofu (Phase 14)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is COMMITTED (Terraform best practice) — not ignored
override.tf
override.tf.json

# Secrets (Phase 15): never commit decrypted material or age keys.
# NOTE: SOPS *.enc.yaml files are encrypted and ARE meant to be committed.
infra/secrets/**/*.dec.yaml
infra/secrets/**/*.plain.yaml
key.txt
*.agekey

# LaTeX build artifacts (report/)
report/latex/*.aux
report/latex/*.bbl
report/latex/*.blg
report/latex/*.out
report/latex/*.toc
report/latex/*.lof
report/latex/*.fls
report/latex/*.log
report/latex/*.fdb_latexmk
report/latex/*.synctex.gz
